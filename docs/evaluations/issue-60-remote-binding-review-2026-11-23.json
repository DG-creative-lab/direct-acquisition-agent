  "findings": [
    {
      "priority": "P2",
      "finding": "Preserve parameter comparison affinity",
      "confirmed_regression": "An internal CAST made a native no-affinity parameter acquire REAL affinity. TEXT values such as 1.00 were selected or updated differently.",
      "fix": "Apply unary plus to remove the internal CAST affinity while preserving exact REAL bits and any explicit caller CAST."
    },
    {
      "priority": "P2",
      "finding": "Resolve numbered aliases to their actual binding slot",
      "confirmed_regression": "SELECT :x,?1 with x=1.5 returned the encoded significand through ?1. Earlier anonymous and alternate-number-spelling aliases were also affected.",
      "fix": "Assign all final slot names before rewriting. Resolve every occurrence through canonical slot identity, including names introduced later. Send fully prefixed Hrana names, preserve all value types and ignore unused dictionary keys. Reject missing or anonymous dictionary slots before dispatch."
    }
  ],
  "authority_map": {
    "oracle": "Native SQLite executes original SQL and original parameters on the same logical fixture. The independent wire fixture perturbs JSON float inputs by one ULP.",
    "effects": "Parameter rewriting selects values for reads, predicates and writes before a single Hrana submission. Existing transaction, lease-at-commit, original-request and uncertain-inference fences remain unchanged.",
    "scope": "Only the adapter binding compiler and regression fixture changed; no schema, runtime authority or frontend behavior was added."
  },
